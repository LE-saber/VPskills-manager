{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LE-saber/VPskills-manager/blob/main/schemas/registry.schema.json",
  "title": "VPskills Manager registry",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "updated_at",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "path",
          "version",
          "status",
          "tags",
          "triggers",
          "compatibility",
          "risk_level",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "path": {
            "type": "string",
            "pattern": "^skills/.+/SKILL\\.md$"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "experimental",
              "deprecated",
              "disabled"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "compatibility": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "type",
              "repository",
              "ref"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "local",
                  "external",
                  "mirrored"
                ]
              },
              "repository": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
